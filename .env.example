# ============================================================
# MRIS SERVER ENVIRONMENT CONFIGURATION
# Copy file ini ke .env dan isi nilainya.
# JANGAN commit .env ke git! (.env sudah ada di .gitignore)
# ============================================================

# ─── DATABASE ───────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=mris_db
MYSQL_PORT=3306

# ─── SECURITY TOKENS ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=ganti_dengan_random_string_32_karakter_atau_lebih

# API key untuk endpoint admin internal /api/db/*
INTERNAL_API_KEY=ganti_dengan_random_string_48_karakter

# Password untuk login phpMyAdmin /phpmyadmin
DB_ADMIN_PASSWORD=ganti_dengan_password_kuat_db_admin

# ─── DEPLOY WEBHOOK ─────────────────────────────────────────
DEPLOY_SECRET=ganti_dengan_random_string_deploy_secret
