<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config untuk MRIS POS APK.
  Hanya mengizinkan koneksi HTTPS ke domain resmi.
  HTTP (cleartext) diblokir total kecuali untuk localhost/LAN (development only).
-->
<network-security-config>

    <!-- Produksi: hanya HTTPS ke domain resmi -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">barokahgroupindonesia.tech</domain>
        <domain includeSubdomains="true">barokahgroupindonesia.com</domain>
    </domain-config>

    <!-- Development/LAN: izinkan HTTP untuk debug ke IP lokal & localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- LAN IP range untuk development (192.168.x.x) -->
        <domain includeSubdomains="false">192.168.1.1</domain>
    </domain-config>

    <!-- Default: blokir cleartext untuk semua domain lain -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust CA resmi dari sistem -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
